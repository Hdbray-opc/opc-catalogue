{
  "name": "carnet-entretien-e2008",
  "productName": "Carnet entretien E-2008",
  "version": "1.1.0",
  "description": "Carnet d'entretien, recharges et budget de la Peugeot E-2008",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy": "node -e \"const fs=require('fs');fs.cpSync('../e2008','app',{recursive:true});fs.cpSync('../entretien/fonts','entretien/fonts',{recursive:true})\"",
    "start": "npm run copy && electron .",
    "dist": "npm run copy && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.hdbray-opc.entretien-e2008",
    "productName": "Carnet entretien E-2008",
    "files": [
      "main.js",
      "app/**/*",
      "entretien/fonts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "app/icon-512.png"
    },
    "portable": {
      "artifactName": "Carnet-entretien-E-2008-${version}.exe"
    }
  }
}
